#!/bin/sh
# Перша лінія оборони: не дати створити коміт із записом співавторства
# або згадкою інструмента-асистента. Друга лінія — pre-push.
. "$(dirname "$0")/attribution-lib.sh"

if ! check_message "$1"; then
	echo "" >&2
	echo "КОМІТ ВІДХИЛЕНО: політика авторства (.githooks/commit-msg)" >&2
	echo "Приберіть трейлери співавторства і згадки інструментів із повідомлення." >&2
	exit 1
fi
exit 0
