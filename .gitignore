# Складені PDF та проміжні файли збирання
build/
*.pdf
!docs/**/*.pdf
# Виняток: готові до друку PDF ревізії. Репозиторій має віддавати книгу
# тому, хто його клонував, не змушуючи спершу ставити pandoc і Typst.
!release/*.pdf

# Робочі файли редакторів і ОС
*~
*.swp
.DS_Store
Thumbs.db

# Тимчасові файли перевірок
.linkcheck-*
.budgets-*

# Чужі документи в git не входять ніколи — правило Р-КЕШ у docs/DESIGN.md.
#
# Взірець нечутливий до регістру навмисно: частина дзеркал віддає файли
# як `.PDF`. Знахідка М2 від 2026-08-26: адреса CH340, з якої вони
# качали, дослівно закінчується на `.PDF`, і `*.pdf` її не спіймав би.
*.[Pp][Dd][Ff]
!release/*.pdf
!docs/**/*.pdf

# Кеш зовнішніх джерел. Головний захист — тримати кеш **поза деревом**
# репозиторію; це тут друга лінія, а не єдина.
source-cache/*
!source-cache/MANIFEST.md
dzherela-cache/
# The pre-rename cache directory. The rename replaced the ignore rule by
# search-and-replace and hit the wrong string — the real directory was
# `dzherela-kesh`, not `dzherela-cache` — so 236 third-party documents
# lost their protection and were swept into a commit by `git add -A`.
# Caught by the pre-push hook, never pushed. Both spellings stay listed:
# an ignore rule for a directory that no longer exists costs nothing.
#
# On what the risk actually was: nothing secret was involved. Every file
# came from a public URL, and no confidentiality obligation applies to
# any of it. The question is redistribution, which is a separate thing
# from disclosure — and even then it is narrow, since most of the cache
# is Apache-2.0 material that may be redistributed freely. The vendor
# PDFs are the ambiguous part. The rule stands mainly because the
# manifest already carries the reproducibility record in kilobytes.
dzherela-kesh/
*.[Zz][Ii][Pp]

# Байткод Python. Збирається з .py за секунди, але прив'язаний до версії
# інтерпретатора: у різних супровідників різні .pyc на ті самі
# інструменти. Відстежувати їх означає двійкові конфлікти у файлах, яких
# ніхто не редагував і які нікому не потрібні.
__pycache__/
*.pyc

# Локальні налаштування, що не належать репозиторію
.claude/settings.local.json

# Реєстр фактчекінгу входить у репозиторій цілком: він і є доказом
